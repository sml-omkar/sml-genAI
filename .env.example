# =============================================================================
# AI-Bot Configuration
# Copy this file to .env and fill in the values
# =============================================================================

# --- Application ---
APP_NAME=AI-Bot
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false
SECRET_KEY=change-this-to-a-random-secret-key-at-least-32-chars

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=aibot_user
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=aibot_db

# --- Ollama (LLM) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=smollm:360m

# --- Embeddings ---
EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5
EMBEDDING_DIMENSIONS=768

# --- ChromaDB ---
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION=policy_documents

# --- JWT Auth ---
JWT_SECRET_KEY=change-this-to-another-random-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- File Upload ---
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=50

# --- Microsoft Teams Bot ---
MicrosoftAppType=MultiTenant
MicrosoftAppId=
MicrosoftAppPassword=
MicrosoftAppTenantId=

# --- RAG Pipeline ---
CHUNK_SIZE=512
CHUNK_OVERLAP=75
TOP_K_RESULTS=5
LLM_TEMPERATURE=0.1
