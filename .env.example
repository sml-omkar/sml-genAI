# =============================================================================
# AI-Bot Configuration
# =============================================================================

# --- Application ---
APP_NAME=AI-Bot
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true
SECRET_KEY=dev-secret-key-change-in-production-32chars

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=aibot_user
POSTGRES_PASSWORD=aibot_pass_2024
POSTGRES_DB=aibot_db

# --- OpenAI (LLM + Embeddings) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# --- Embeddings (Ollama local) ---
EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5
EMBEDDING_DIMENSIONS=768

# --- ChromaDB ---
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION=policy_chunks

# --- JWT Auth ---
JWT_SECRET_KEY=jwt-secret-key-change-in-production-32chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- File Upload ---
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=50

# --- Microsoft Teams Bot ---
MicrosoftAppType=MultiTenant
MicrosoftAppId=
MicrosoftAppPassword=
MicrosoftAppTenantId=

# --- RAG Pipeline ---
CHUNK_SIZE=640
CHUNK_OVERLAP=150
TOP_K_RESULTS=5
LLM_TEMPERATURE=0.1
